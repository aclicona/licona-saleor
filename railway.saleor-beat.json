{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "nixpacksPlan": {
      "providers": []
    }
  },
  "deploy": {
    "startCommand": "sh scripts/railway-entrypoint.sh celery -A saleor beat --scheduler saleor.schedulers.schedulers.DatabaseScheduler",
    "preDeployCommand": [
      "sh scripts/wait-for-migrations.sh"
    ],
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
