# Django
SECRET_KEY=changeme-local-dev-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos (dj-database-url)
DATABASE_URL=postgres://postgres@localhost:5432/saleor

# Redis (cache + channel layers)
REDIS_URL=redis://localhost:6379/0

# Celery broker
CELERY_BROKER_URL=redis://localhost:6379/1

# JWT — generar con: openssl genrsa 2048
# Pegar el PEM completo entre comillas (incluye saltos de línea)
RSA_PRIVATE_KEY=

# Email — console:// imprime emails en stdout (útil para dev)
EMAIL_URL=console://

# Media y static — vacío = almacenamiento local en ./media/ y ./static/
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_MEDIA_BUCKET_NAME=
AWS_STORAGE_BUCKET_NAME=
