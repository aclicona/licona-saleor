{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "nixpacksPlan": {
      "providers": []
    }
  },
  "deploy": {
    "preDeployCommand": "sh /app/scripts/wait-for-db.sh && python manage.py migrate --noinput",
    "startCommand": "sh -c 'uvicorn saleor.asgi:application --host=0.0.0.0 --port=${PORT:-8000} --workers=2 --lifespan=off --ws=none --no-server-header --no-access-log --timeout-keep-alive=35 --timeout-graceful-shutdown=30 --limit-max-requests=10000'",
    "healthcheckPath": "/health/",
    "healthcheckTimeout": 30,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
